{
    "name": "ruudk/graphql-client-code-generator",
    "description": "Transform GraphQL queries into type-safe, zero-dependency PHP 8.4+ code that just works.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "composer-runtime-api": "^2.0",
        "nikic/php-parser": "^5.7",
        "phpstan/phpdoc-parser": "^2.3",
        "phpstan/phpstan": "^2.2.1",
        "ruudk/code-generator": "^1.0",
        "sebastian/diff": "^9.0",
        "symfony/console": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/string": "^8.0",
        "symfony/type-info": "^8.0.6",
        "webmozart/assert": "^2.0",
        "webonyx/graphql-php": "^15.24.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.61",
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95.18",
        "guzzlehttp/psr7": "^2.9",
        "php-http/discovery": "^1.20",
        "php-http/guzzle7-adapter": "^1.1",
        "php-http/message": "^1.16.2",
        "php-http/mock-client": "^1.6.1",
        "phpunit/phpunit": "^13.4.8",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^2.0",
        "ruudk/readme-examples-sync-hook": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symfony/dependency-injection": "^7.4 || ^8.0.8",
        "symfony/dotenv": "^7.4 || ^8.0.8",
        "symfony/var-dumper": "^7.4 || ^8.0.8",
        "twig/twig": "^3.24",
        "vincentlanglet/twig-cs-fixer": "^3.14"
    },
    "suggest": {
        "carthage-software/mago": "For the Mago extension that formats GraphQL in PHP and restricts usage of generated classes",
        "friendsofphp/php-cs-fixer": "For the PHP CS Fixer fixer that formats GraphQL in PHP",
        "twig/twig": "For generating GraphQL fragments from Twig templates",
        "vincentlanglet/twig-cs-fixer": "For the Twig CS Fixer rule that formats GraphQL in Twig templates"
    },
    "autoload": {
        "psr-4": {
            "Ruudk\\GraphQLCodeGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruudk\\GraphQLCodeGenerator\\": "tests/",
            "Ruudk\\GraphQLCodeGenerator\\Examples\\": "examples/"
        }
    },
    "bin": [
        "bin/graphql-client-code-generator"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "command -v lefthook >/dev/null 2>&1 && lefthook install || true"
        ],
        "post-autoload-dump": [
            "@php .mago/extract-phpstan-sources.php"
        ]
    }
}
